{
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/pria/to/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/pria",
      "destination": "/index.html"
    },
    {
      "source": "/wanita/to/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/wanita",
      "destination": "/index.html"
    },
    {
      "source": "/to/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/to",
      "destination": "/index.html"
    },
    {
      "source": "/:slug/to/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/:slug",
      "destination": "/index.html"
    }
  ]
}
